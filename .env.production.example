# Copy these into your host's environment variable settings.
# Never commit the filled-in version.

APP_NAME=Dylanquent
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dylanquent.com

# Generate with: php artisan key:generate --show
APP_KEY=

# --- Database -------------------------------------------------------------
# SQLite on a VPS with a mounted volume is fine at this scale.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Switch to Postgres on hosts without a persistent disk (Neon free tier):
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- File storage ---------------------------------------------------------
# 'public' = local disk (needs a persistent volume).
# 's3'     = Cloudflare R2 or any S3-compatible bucket, required on
#            ephemeral hosts. Uploads follow this setting automatically.
FILESYSTEM_DISK=public

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_URL=https://cdn.yourdomain.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail -----------------------------------------------------------------
# Order confirmations silently vanish while this is 'log'.
# Resend and Brevo both have free tiers.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=orders@dylanquent.com
MAIL_FROM_NAME="Dylanquent"

# --- Payments -------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LOG_CHANNEL=stderr
LOG_LEVEL=warning
